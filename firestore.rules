rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validTeam() {
      return request.resource.data.keys().hasOnly([
          'name', 'icon', 'score', 'color', 'order', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'icon', 'score', 'color', 'order', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 2048
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.order is int
        && request.resource.data.order >= 0
        && request.resource.data.updatedAt is timestamp;
    }

    function validSettings() {
      return request.resource.data.keys().hasOnly([
          'maxScore', 'schemaVersion', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'maxScore', 'schemaVersion', 'updatedAt'
        ])
        && request.resource.data.maxScore is number
        && request.resource.data.maxScore > 0
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is timestamp;
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update: if signedIn() && validTeam();
      allow delete: if signedIn();
    }

    match /settings/leaderboard {
      allow read: if true;
      allow create, update: if signedIn() && validSettings();
      allow delete: if signedIn();
    }
  }
}
